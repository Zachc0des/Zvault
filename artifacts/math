<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Foundations — A Beginner's Map of Math</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep: #0e2038;
    --navy-panel: #142c4c;
    --navy-panel-2: #17335a;
    --grid-line: rgba(233,238,245,0.07);
    --grid-line-strong: rgba(233,238,245,0.14);
    --paper: #f3f0e7;
    --ink: #e7ecf4;
    --ink-soft: #a9bcd6;
    --ink-faint: #6f84a3;
    --amber: #e3a441;
    --amber-soft: rgba(227,164,65,0.16);
    --rule: rgba(233,238,245,0.18);
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background: var(--navy-deep);
    color: var(--ink);
    font-family: 'IBM Plex Sans', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,h2,h3,h4{
    font-family: 'Fraunces', serif;
    font-weight: 600;
    margin: 0;
    color: var(--paper);
  }

  a{ color: inherit; }

  .mono{
    font-family: 'IBM Plex Mono', monospace;
  }

  /* Blueprint grid backdrop, used sparingly */
  .grid-bg{
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  /* ---------- NAV ---------- */
  nav{
    position: sticky; top:0; z-index: 50;
    display:flex; align-items:center; justify-content:space-between;
    padding: 18px 5vw;
    background: rgba(14,32,56,0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family:'Fraunces', serif; font-size: 1.05rem; color: var(--paper);
    letter-spacing: 0.01em;
  }
  .brand svg{ width:22px; height:22px; }
  .nav-links{
    display:flex; gap: 28px;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .nav-links a{ text-decoration:none; transition: color .2s; }
  .nav-links a:hover{ color: var(--amber); }
  @media (max-width: 720px){ .nav-links{ display:none; } }

  /* ---------- HERO ---------- */
  .hero{
    position: relative;
    padding: 120px 5vw 90px;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }
  .hero-inner{ max-width: 760px; position: relative; z-index: 2; }
  .hero-tag{
    font-family:'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    color: var(--amber);
    display:flex; align-items:center; gap:10px;
    margin-bottom: 22px;
  }
  .hero-tag::before{
    content:""; width:26px; height:1px; background: var(--amber);
  }
  .hero h1{
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .hero h1 em{ font-style: italic; color: var(--amber); }
  .hero p.lede{
    margin-top: 26px;
    max-width: 54ch;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
  .hero-meta{
    margin-top: 46px;
    display:flex; gap: 46px; flex-wrap: wrap;
  }
  .hero-meta div{ max-width: 220px; }
  .hero-meta .num{
    font-family:'IBM Plex Mono', monospace;
    color: var(--amber); font-size: 0.85rem;
  }
  .hero-meta p{ margin: 6px 0 0; color: var(--ink-soft); font-size: 0.92rem; }

  .dim-line{
    position:absolute; background: var(--grid-line-strong);
  }

  /* ---------- SECTION SHELL ---------- */
  section{ padding: 84px 5vw; border-bottom: 1px solid var(--rule); }
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    gap: 24px; margin-bottom: 48px; flex-wrap: wrap;
  }
  .section-head h2{ font-size: clamp(1.8rem, 3.4vw, 2.4rem); max-width: 20ch; }
  .section-head .index{
    font-family:'IBM Plex Mono', monospace;
    color: var(--ink-faint); font-size: 0.85rem; text-align: right;
  }
  .section-intro{
    max-width: 62ch; color: var(--ink-soft); font-size: 1.02rem;
    margin-bottom: 8px;
  }

  /* ---------- WHY PILLARS INTRO ---------- */
  .intro-columns{
    display:grid; grid-template-columns: 1.1fr 1fr; gap: 60px;
    align-items: start;
  }
  @media (max-width: 860px){ .intro-columns{ grid-template-columns: 1fr; } }
  .intro-columns p{ color: var(--ink-soft); margin: 0 0 16px; }
  .intro-columns strong{ color: var(--paper); font-weight: 500; }
  .callout{
    border-left: 2px solid var(--amber);
    padding: 4px 0 4px 22px;
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    color: var(--paper);
    font-style: italic;
  }

  /* ---------- PILLARS ---------- */
  .pillar{
    display:grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    padding: 52px 0;
    border-top: 1px solid var(--rule);
  }
  .pillar:first-of-type{ border-top: none; padding-top: 0; }
  @media (max-width: 860px){ .pillar{ grid-template-columns: 1fr; gap: 24px; } }

  .pillar-visual{
    position: relative;
    background: var(--navy-panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 22px;
    min-height: 220px;
    display:flex; flex-direction:column; justify-content:space-between;
  }
  .pillar-visual .tag{
    font-family:'IBM Plex Mono', monospace; font-size: 0.72rem; color: var(--ink-faint);
  }
  .pillar-visual svg{ width: 100%; height: 130px; }
  .pillar-visual svg *{ stroke: var(--amber); }

  .pillar-body h3{
    font-size: 1.5rem;
    display:flex; align-items:baseline; gap: 14px;
  }
  .pillar-body h3 .no{
    font-family:'IBM Plex Mono', monospace; font-size: 0.85rem; color: var(--ink-faint); font-weight: 400;
  }
  .pillar-def{
    margin-top: 10px; color: var(--ink-soft); max-width: 62ch; font-size: 1.02rem;
  }

  .pillar-grid{
    margin-top: 26px;
    display:grid; grid-template-columns: 1fr 1fr; gap: 24px;
  }
  @media (max-width: 620px){ .pillar-grid{ grid-template-columns: 1fr; } }
  .pillar-grid h4{
    font-family:'IBM Plex Mono', monospace; font-weight: 500; font-size: 0.76rem;
    color: var(--amber); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.06em;
  }
  .pillar-grid ul{ margin:0; padding-left: 18px; color: var(--ink-soft); font-size: 0.94rem; }
  .pillar-grid li{ margin-bottom: 6px; }

  .example-box{
    margin-top: 22px;
    background: var(--navy-panel-2);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 18px 20px;
  }
  .example-box .label{
    font-family:'IBM Plex Mono', monospace; font-size: 0.72rem; color: var(--ink-faint);
    margin-bottom: 8px; display:block;
  }
  .example-box p{ margin:0; color: var(--ink); font-size: 0.96rem; }

  /* ---------- MAP / DEPENDENCY DIAGRAM ---------- */
  .map-wrap{
    background: var(--navy-panel);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 8px;
    overflow-x: auto;
  }
  .map-wrap svg{ display:block; min-width: 720px; width: 100%; height: auto; }

  /* ---------- HOW TO LEARN ---------- */
  .practice-list{
    display:grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 720px){ .practice-list{ grid-template-columns: 1fr; } }
  .practice-item{
    background: var(--navy-deep);
    padding: 30px 32px;
  }
  .practice-item h4{
    font-family: 'Fraunces', serif; font-weight: 600; color: var(--paper);
    font-size: 1.15rem; margin-bottom: 10px;
  }
  .practice-item p{ color: var(--ink-soft); margin:0; font-size: 0.96rem; }

  /* ---------- FOOTER ---------- */
  footer{
    padding: 60px 5vw 70px;
    display:flex; justify-content: space-between; align-items: flex-end; gap: 30px; flex-wrap: wrap;
  }
  footer .fnote{ max-width: 46ch; color: var(--ink-soft); font-size: 0.96rem; }
  footer .fmark{ font-family:'IBM Plex Mono', monospace; font-size: 0.78rem; color: var(--ink-faint); text-align:right; }

  ::selection{ background: var(--amber-soft); color: var(--paper); }
</style>
